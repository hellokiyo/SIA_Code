</div>

<a type="" href="/main">메인페이지로 돌아가기</a>


<script>
    const selectId = Number(document.querySelector('#selectId').value) // 검색할 아이디
    let rows = await conn.query(sql);
    const sql = `select id, name, age, mobile from test.person where ${selectId}`;

    function select () {
        document.querySelector(`#viewId`).value =  rows[selectId].id
        document.querySelector(`#viewName`).value =  rows[selectId].name
